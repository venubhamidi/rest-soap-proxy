<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://insurance.com/fraud"
    targetNamespace="http://insurance.com/fraud">

  <wsdl:types>
    <xs:schema targetNamespace="http://insurance.com/fraud"
               xmlns:tns="http://insurance.com/fraud"
               elementFormDefault="qualified">

      <!-- Simple enum restriction -->
      <xs:simpleType name="ClaimType">
        <xs:restriction base="xs:string">
          <xs:enumeration value="AUTO_COLLISION"/>
          <xs:enumeration value="THEFT"/>
          <xs:enumeration value="FIRE"/>
        </xs:restriction>
      </xs:simpleType>

      <!-- Nested complex type -->
      <xs:complexType name="Location">
        <xs:sequence>
          <xs:element name="city" type="xs:string"/>
          <xs:element name="state" type="xs:string"/>
          <xs:element name="zipCode" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>

      <!-- Complex type with an XSD attribute (required) -->
      <xs:complexType name="Claim">
        <xs:sequence>
          <xs:element name="claimId" type="xs:string"/>
          <xs:element name="paidAmount" type="xs:decimal" minOccurs="0"/>
          <xs:element name="filedAt" type="xs:dateTime" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required"/>
      </xs:complexType>

      <!-- Extension of a base complex type -->
      <xs:complexType name="PremiumClaim">
        <xs:complexContent>
          <xs:extension base="tns:Claim">
            <xs:sequence>
              <xs:element name="premiumTier" type="xs:string"/>
            </xs:sequence>
          </xs:extension>
        </xs:complexContent>
      </xs:complexType>

      <!-- Wrapper list: single unbounded child element -->
      <xs:complexType name="RecentClaimList">
        <xs:sequence>
          <xs:element name="recentClaim" type="tns:Claim" maxOccurs="unbounded" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>

      <!-- Wrapper list of scalars -->
      <xs:complexType name="StringList">
        <xs:sequence>
          <xs:element name="value" type="xs:string" maxOccurs="unbounded" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>

      <!-- Choice type -->
      <xs:complexType name="Contact">
        <xs:choice>
          <xs:element name="email" type="xs:string"/>
          <xs:element name="phone" type="xs:string"/>
        </xs:choice>
      </xs:complexType>

      <xs:element name="checkFraudRiskRequest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="customerId" type="xs:string"/>
            <xs:element name="claimType" type="tns:ClaimType"/>
            <xs:element name="estimatedAmount" type="xs:decimal" minOccurs="0"/>
            <xs:element name="incidentLocation" type="tns:Location" nillable="true" minOccurs="0"/>
            <xs:element name="recentClaims" type="tns:RecentClaimList" minOccurs="0"/>
            <xs:element name="tags" type="tns:StringList" minOccurs="0"/>
            <xs:element name="contact" type="tns:Contact" minOccurs="0"/>
            <xs:element name="premiumClaim" type="tns:PremiumClaim" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element name="checkFraudRiskResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="riskScore" type="xs:decimal"/>
            <xs:element name="decision" type="xs:string"/>
            <xs:element name="flagged" type="xs:boolean" nillable="true"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <!-- Single-scalar-parameter operation for normalization tests -->
      <xs:element name="echoRequest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="message" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="echoResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="message" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </wsdl:types>

  <wsdl:message name="checkFraudRiskInput">
    <wsdl:part name="parameters" element="tns:checkFraudRiskRequest"/>
  </wsdl:message>
  <wsdl:message name="checkFraudRiskOutput">
    <wsdl:part name="parameters" element="tns:checkFraudRiskResponse"/>
  </wsdl:message>
  <wsdl:message name="echoInput">
    <wsdl:part name="parameters" element="tns:echoRequest"/>
  </wsdl:message>
  <wsdl:message name="echoOutput">
    <wsdl:part name="parameters" element="tns:echoResponse"/>
  </wsdl:message>

  <wsdl:portType name="FraudDetectionPort">
    <wsdl:operation name="checkFraudRisk">
      <wsdl:documentation>Assess the fraud risk of an insurance claim.</wsdl:documentation>
      <wsdl:input message="tns:checkFraudRiskInput"/>
      <wsdl:output message="tns:checkFraudRiskOutput"/>
    </wsdl:operation>
    <wsdl:operation name="echo">
      <wsdl:input message="tns:echoInput"/>
      <wsdl:output message="tns:echoOutput"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="FraudDetectionBinding" type="tns:FraudDetectionPort">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="checkFraudRisk">
      <soap:operation soapAction="http://insurance.com/fraud/checkFraudRisk"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="echo">
      <soap:operation soapAction="http://insurance.com/fraud/echo"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="FraudDetectionService">
    <wsdl:port name="FraudDetectionPort" binding="tns:FraudDetectionBinding">
      <soap:address location="http://localhost:8080/ws"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
