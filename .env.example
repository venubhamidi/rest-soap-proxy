# Inbound auth: bearer token the MCP client (e.g. ContextForge) must present
# to /mcp. If unset, the endpoint runs OPEN (dev mode) and logs a warning.
PROXY_BEARER_TOKEN=change-me

# HTTP port for uvicorn.
PORT=8080

# Path to the service registry file (default: services.yaml).
# SERVICES_CONFIG=services.yaml

# Upstream SOAP secrets referenced as ${VAR} in services.yaml, e.g.:
# WEATHER_SOAP_PASSWORD=...
# CLAIMS_USER=...
# CLAIMS_PASSWORD=...
